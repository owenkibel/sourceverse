---
import { getCollection } from 'astro:content';

// Tries 'blog' first, falls back to 'posts' or an empty array
let allPosts = [];
try {
  allPosts = await getCollection('blog', ({ data }) => !data.draft);
} catch {
  try {
    allPosts = await getCollection('posts', ({ data }) => !data.draft);
  } catch {
    allPosts = [];
  }
}

// If your project uses Astro.glob instead of Content Collections:
if (allPosts.length === 0) {
  try {
    const rawPosts = Object.values(import.meta.glob('../posts/*.{md,mdx}', { eager: true }));
    allPosts = rawPosts.map((p: any) => ({
      data: p.frontmatter || {},
      slug: p.url?.replace(/^\/posts\//, '').replace(/\/$/, '') || ''
    }));
  } catch {}
}

const tagCounts = allPosts.reduce((acc, post: any) => {
  (post.data.tags || []).forEach((tag: string) => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

const sortedTags = Object.keys(tagCounts).sort((a, b) => a.localeCompare(b));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Topic Directory | Latent Verse</title>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <main class="tag-directory">
      <header class="directory-header">
        <nav class="breadcrumb">
          <a href="/" class="back-link">&larr; Back to Home</a>
        </nav>
        <h1>Topic Directory</h1>
        <p>Browse verses, audio, and generations by tag.</p>
      </header>

      <div class="tag-cloud">
        {sortedTags.map((tag) => (
          <a href={`/tags/${tag}/`} class="tag-pill">
            <span class="tag-name">#{tag}</span>
            <span class="tag-count">{tagCounts[tag]}</span>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>

<style>
  body {
    background-color: #0f0f11;
    color: #e4e4e7;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    margin: 0;
    padding: 0;
  }
  .tag-directory { max-width: 860px; margin: 2.5rem auto; padding: 0 1.25rem; }
  .directory-header { margin-bottom: 2rem; border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 1.25rem; }
  .breadcrumb { margin-bottom: 0.75rem; }
  .back-link { font-size: 0.85rem; color: #a1a1aa; text-decoration: none; }
  .back-link:hover { color: #818cf8; }
  .tag-cloud { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.04);
    color: #f4f4f5;
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-decoration: none;
    font-size: 0.9rem;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .tag-pill:hover { border-color: #818cf8; transform: translateY(-2px); }
  .tag-count {
    font-size: 0.75rem;
    padding: 0.1rem 0.45rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    color: #a1a1aa;
  }
</style>