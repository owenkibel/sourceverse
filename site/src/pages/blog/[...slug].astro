---
// src/pages/blog/[...slug].astro
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		// FIX: Force the path parameter registration to be completely lowercase.
		// This eliminates the 404 error caused by uppercase ISO timestamps (T and Z).
		params: { slug: post.id.toLowerCase() },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

// Provide safe defaults so the theme layout component doesn't crash on undefined values
const safeData = {
	title: post.data.title,
	description: post.data.description || "Generated Asset",
	// Fall back to the current date if your front matter lacks a pubDate property
	pubDate: post.data.pubDate || new Date(), 
	heroImage: post.data.image, // Retains your exact 'image' mapping to the theme's 'heroImage' slot
};
---

<BlogPost {...safeData}>
	{post.data.video && (
		<video controls playsinline style="max-width: 100%; margin: 20px 0; display: block; border-radius: 12px; box-shadow: var(--box-shadow);">
			<source src={post.data.video} type="video/mp4" />
		</video>
	)}

	{post.data.tts && (
		<audio controls style="width: 100%; margin: 20px 0; display: block;">
			<source src={post.data.tts} type="audio/opus" />
		</audio>
	)}

	<Content />

<!-- Mermaid and svg-pan-zoom CDN bundles -->
<script is:inline src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/svg-pan-zoom@3.6.1/dist/svg-pan-zoom.min.js"></script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', async () => {
    const targets = document.querySelectorAll(
      'pre[data-language="mermaid"], pre.language-mermaid, pre code.language-mermaid, pre.astro-code[data-language="mermaid"]'
    );

    if (targets.length === 0 || typeof mermaid === 'undefined') return;

    mermaid.initialize({
      startOnLoad: false,
      theme: 'dark',
      securityLevel: 'loose',
      fontFamily: 'inherit'
    });

    const processed = new Set();

    for (const el of targets) {
      const pre = el.tagName.toLowerCase() === 'pre' ? el : el.closest('pre');
      if (!pre || processed.has(pre)) continue;
      processed.add(pre);

      // Identify the outermost code-block container to eliminate the outer blue-gray box
      const outerContainer = pre.closest('.expressive-code, figure, .code-block') || pre;

      // 1. Extract diagram lines while preserving line breaks
      let rawLines = [];
      const lineSpans = pre.querySelectorAll('.line');
      if (lineSpans.length > 0) {
        lineSpans.forEach((s) => rawLines.push(s.textContent));
      } else {
        rawLines = (pre.textContent || '').split('\n');
      }

      let diagramCode = rawLines.join('\n').trim();

      // 2. Strip rogue markdown code fences
      diagramCode = diagramCode.replace(/```(?:mermaid)?/gi, '').trim();

      // 3. Locate diagram keyword (graph, flowchart, sequenceDiagram, etc.)
      const keywordMatch = diagramCode.match(
        /\b(graph|flowchart|sequenceDiagram|classDiagram|stateDiagram(?:-v2)?|erDiagram|journey|gantt|pie|gitGraph|mindmap|timeline)\b/i
      );
      if (keywordMatch) {
        diagramCode = diagramCode.slice(keywordMatch.index);
      }

      // 4. Verify the diagram contains actual statements (not just an empty declaration)
      const validLines = diagramCode
        .split('\n')
        .map((l) => l.trim())
        .filter((l) => l.length > 0 && !l.startsWith('%%'));

      // If there is only the header (e.g. "graph TD") and no nodes, remove the block completely
      if (!keywordMatch || validLines.length <= 1) {
        outerContainer.remove();
        continue;
      }

      // 5. Build clean viewport and replace the outer container
      const wrapper = document.createElement('div');
      wrapper.className = 'mermaid-viewport';

      const mContainer = document.createElement('div');
      mContainer.className = 'mermaid';
      mContainer.textContent = diagramCode;

      wrapper.appendChild(mContainer);
      outerContainer.parentNode.replaceChild(wrapper, outerContainer);

      // 6. Render SVG, then pull it directly into the viewport wrapper
      try {
        await mermaid.run({ nodes: [mContainer] });

        const svg = mContainer.querySelector('svg');
        if (!svg) throw new Error('No SVG generated by Mermaid');

        // Move SVG directly into wrapper to eliminate parent height mismatches
        wrapper.appendChild(svg);
        mContainer.remove();

        svg.style.width = '100%';
        svg.style.height = '100%';
        svg.style.maxWidth = 'none';

        // 7. Bind svgPanZoom directly to the container
        if (typeof svgPanZoom !== 'undefined') {
          svgPanZoom(svg, {
            zoomEnabled: true,
            controlIconsEnabled: true,
            mouseWheelZoomEnabled: false, // Prevents page-scroll hijacking
            dblClickZoomEnabled: true,
            fit: true,
            center: true,
            minZoom: 0.1,
            maxZoom: 10
          });
        }
      } catch (mErr) {
        console.warn('Mermaid render error; removing broken block:', mErr);
        wrapper.remove();
      }
    }
  });
</script>

<style is:global>
  .mermaid-viewport {
    position: relative;
    width: 100%;
    height: 520px;
    margin: 2rem 0;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    overflow: hidden;
    box-sizing: border-box;
    cursor: grab;
  }

  .mermaid-viewport:active {
    cursor: grabbing;
  }

  .mermaid-viewport svg {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  /* Node styling */
  .mermaid-viewport svg .node rect,
  .mermaid-viewport svg .node circle,
  .mermaid-viewport svg .node polygon,
  .mermaid-viewport svg .node path {
    fill: #1e293b !important;
    stroke: #38bdf8 !important;
    stroke-width: 1.5px !important;
  }

  .mermaid-viewport svg text,
  .mermaid-viewport svg .nodeLabel,
  .mermaid-viewport svg .label {
    fill: #f8fafc !important;
    color: #f8fafc !important;
    font-weight: 500 !important;
  }

  /* Edges and connectors */
  .mermaid-viewport svg .edgePath path,
  .mermaid-viewport svg .flowchart-link {
    stroke: #94a3b8 !important;
    stroke-width: 1.8px !important;
  }

  .mermaid-viewport svg .edgeLabel {
    background-color: #0f172a !important;
    fill: #cbd5e1 !important;
    color: #cbd5e1 !important;
  }

  .mermaid-viewport svg marker path {
    fill: #94a3b8 !important;
    stroke: #94a3b8 !important;
  }

  /* Pan-zoom controls anchored in bottom corner */
  .svg-pan-zoom-control {
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }
  .svg-pan-zoom-control:hover {
    opacity: 1;
  }
  .svg-pan-zoom-control path {
    fill: #e4e4e7 !important;
  }
  .svg-pan-zoom-control rect {
    fill: #27272a !important;
    stroke: #3f3f46 !important;
  }
</style>
</BlogPost>


